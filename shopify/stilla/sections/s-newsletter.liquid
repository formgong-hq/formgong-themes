{%- comment -%} Stilla newsletter band: a tall photo beside a large heading and a signup form. {%- endcomment -%}
<section class="s-news" id="newsletter" aria-labelledby="news-{{ section.id }}">
  <div class="s-split-img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 960, 1600', sizes: '(max-width: 900px) 100vw, 50vw', loading: 'lazy', alt: section.settings.image.alt | default: '' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 's-placeholder' }}
    {%- endif -%}
  </div>
  <div class="s-news-tx"><h2 id="news-{{ section.id }}">{{ section.settings.heading }}</h2>{% render 's-signup', id: 'signup-band', note: section.settings.note %}</div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up for our newsletter" },
    { "type": "richtext", "id": "note", "label": "Note under the form", "default": "<p>Unsubscribe any time.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
