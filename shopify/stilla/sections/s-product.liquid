{%- comment -%}
  Stilla product page: gallery, options as chips (colour swatches and sizes), Add to bag, perks, accordions, the
  size question form (Formgong, key in Theme settings) and related products. Without JavaScript the form posts to the
  cart and the options fall back to the first available variant.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign size_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'size'
      assign size_index = forloop.index0
    endif
  endfor
-%}
<div class="s-pdp" data-s-product data-size-index="{{ size_index }}">
  <div class="s-gal">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- liquid
          if forloop.first
            assign sizes = '(max-width: 900px) 86vw, 52vw'
            assign loading = 'eager'
          else
            assign sizes = '(max-width: 900px) 86vw, 26vw'
            assign loading = 'lazy'
          endif
        -%}
        {{ media | image_url: width: 1600 | image_tag: widths: '480, 960, 1600', sizes: sizes, loading: loading, alt: media.alt | default: product.title }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 's-placeholder' }}
    {%- endfor -%}
  </div>
  <div class="s-info"><div class="s-info-in">
    <nav class="s-crumbs" aria-label="{{ 'stilla.breadcrumb' | t }}"><ol><li><a href="{{ routes.root_url }}">{{ 'stilla.home' | t }}</a></li>{% if collection %}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{% endif %}<li><span aria-current="page">{{ product.title }}</span></li></ol></nav>
    <h1>{{ product.title }}</h1>
    <p class="s-price" data-price>{% render 's-price', variant: current %}</p>

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- assign option_name = option.name | downcase -%}
        {%- assign is_colour = false -%}
        {%- if option_name == 'colour' or option_name == 'color' %}{% assign is_colour = true %}{% endif -%}
        <p class="s-opt-l" id="opt-{{ section.id }}-{{ forloop.index }}">{{ option.name }}: <b id="pick-{{ section.id }}-{{ forloop.index }}" data-empty="{{ 'stilla.product.choose' | t }}">{{ option.selected_value }}</b></p>
        <div class="{% if is_colour %}s-colors{% else %}s-sizes{% endif %}" role="radiogroup" aria-labelledby="opt-{{ section.id }}-{{ forloop.index }}" data-option-index="{{ forloop.index0 }}" data-pick="pick-{{ section.id }}-{{ forloop.index }}">
          {%- for value in option.values -%}
            <label class="s-chip"><input type="radio" name="option-{{ section.id }}-{{ forloop.parentloop.index }}" value="{{ value.name | escape }}"{% if value.selected %} checked{% endif %}><span>
              {%- if is_colour -%}<i style="background:{% render 's-swatch', value: value %}"></i><span class="s-sr">{{ value.name }}</span>{%- else -%}{{ value.name }}{%- endif -%}
            </span></label>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    {%- endunless -%}

    {%- form 'product', product, class: 's-buy-form', data-s-add: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}">
      {%- if product.gift_card? %}{% render 'gift-card-recipient', form: form, section_id: section.id %}{% endif -%}
      <div class="s-buy"><button class="s-btn" type="submit"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'stilla.product.add' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button></div>
    {%- endform -%}
    <script type="application/json" data-variants>
      [{%- for variant in product.variants -%}{%- capture price_html -%}{% render 's-price', variant: variant %}{%- endcapture -%}{"id":{{ variant.id }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price_html":{{ price_html | strip | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
    </script>

    {%- assign accordion_done = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'perks' -%}
          <ul class="s-perks" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}{%- assign key = 'perk_' | append: i -%}{%- if block.settings[key] != blank %}<li>{{ block.settings[key] }}</li>{% endif -%}{%- endfor -%}
          </ul>
        {%- when 'description', 'collapsible' -%}
          {%- comment -%} All accordion blocks render together where the first one stands, so they share one list. {%- endcomment -%}
          {%- unless accordion_done -%}
            {%- assign accordion_done = true -%}
            <div class="s-acc">
              {%- for item in section.blocks -%}
                {%- if item.type == 'description' and product.description != blank -%}
                  <details open {{ item.shopify_attributes }}><summary>{{ item.settings.heading }}</summary>{{ product.description }}</details>
                {%- elsif item.type == 'collapsible' -%}
                  <details {{ item.shopify_attributes }}><summary>{{ item.settings.heading }}</summary>{{ item.settings.text }}</details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}
        {%- when 'ask' -%}
          {%- if settings.formgong_key != blank -%}
            <section class="s-ask" id="ask" aria-labelledby="ask-{{ section.id }}" {{ block.shopify_attributes }}>
              <h2 id="ask-{{ section.id }}">{{ block.settings.heading }}</h2>
              <p>{{ block.settings.text }}</p>
              <form class="s-fg" action="https://formgong.com/submit" method="POST">
                <input type="hidden" name="access_key" value="{{ settings.formgong_key | escape }}">
                <input type="hidden" name="request" value="{{ block.settings.request | escape }}">
                <input type="hidden" name="product" value="{{ product.title | escape }} ({{ current.title | escape }})" data-title="{{ product.title | escape }}">
                <div aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)"><label>{{ 'stilla.ask.leave_empty' | t }}<input type="text" name="botcheck" tabindex="-1" autocomplete="off"></label></div>
                <div class="s-fields">
                  <div class="s-two">
                    <div class="s-field"><label for="ask-name-{{ section.id }}">{{ 'stilla.ask.name' | t }}</label><input id="ask-name-{{ section.id }}" name="name" autocomplete="name" required></div>
                    <div class="s-field"><label for="ask-email-{{ section.id }}">{{ 'stilla.signup.email' | t }}</label><input id="ask-email-{{ section.id }}" type="email" name="email" autocomplete="email" required></div>
                  </div>
                  <div class="s-two">
                    {%- if size_index >= 0 -%}
                      <div class="s-field"><label for="ask-size-{{ section.id }}">{{ 'stilla.ask.size' | t }}</label><select id="ask-size-{{ section.id }}" name="size">{% for value in product.options_with_values[size_index].values %}<option{% if value.selected %} selected{% endif %}>{{ value.name }}</option>{% endfor %}</select></div>
                    {%- endif -%}
                    <div class="s-field"><label for="ask-height-{{ section.id }}">{{ 'stilla.ask.height' | t }}</label><input id="ask-height-{{ section.id }}" name="height" inputmode="numeric" maxlength="3"></div>
                  </div>
                  <div class="s-field"><label for="ask-msg-{{ section.id }}">{{ 'stilla.ask.question' | t }}</label><textarea id="ask-msg-{{ section.id }}" name="message" required></textarea></div>
                  <button class="s-btn" type="submit">{{ 'stilla.ask.send' | t }}</button>
                </div>
                <p class="s-ok" tabindex="-1">{{ block.settings.thanks }}</p>
                <p class="s-status" role="status"></p>
              </form>
            </section>
          {%- elsif request.design_mode -%}
            <p class="s-ask" {{ block.shopify_attributes }}>{{ 'stilla.ask.needs_key' | t }}</p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div></div>
</div>

{%- if section.settings.related_heading != blank -%}
  {%- liquid
    assign related = product.collections.first
    if related == blank
      assign related = collections.all
    endif
  -%}
  <div class="s-row-head"><h2>{{ section.settings.related_heading }}</h2><a class="s-link" href="{{ related.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a></div>
  <div class="s-grid">
    {%- assign shown = 0 -%}
    {%- for item in related.products limit: 5 -%}
      {%- if item.id != product.id and shown < 4 -%}{% render 's-card', product: item %}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "related_heading", "label": "Related products heading", "default": "You may also like", "info": "Products from the same collection. Leave empty to hide." }
  ],
  "blocks": [
    { "type": "perks", "name": "Perks", "limit": 1, "settings": [
      { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Free delivery over a set amount" },
      { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "30-day returns" },
      { "type": "text", "id": "perk_3", "label": "Perk 3" }
    ] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Description" }
    ] },
    { "type": "collapsible", "name": "Collapsible text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Fit and care" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>How it fits and how to wash it.</p>" }
    ] },
    { "type": "ask", "name": "Size question form", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Sends to Formgong. Paste your access key in Theme settings → Formgong." },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure about the size?" },
      { "type": "text", "id": "text", "label": "Text", "default": "Tell us your usual size and height. We will answer by email." },
      { "type": "text", "id": "request", "label": "Request name in your inbox", "default": "Size question" },
      { "type": "text", "id": "thanks", "label": "Thank-you text", "default": "Thanks, your question is sent. We will answer by email." }
    ] }
  ]
}
{% endschema %}
