{%- layout none -%}
{%- liquid
  assign initial_money = gift_card.initial_value | money
  assign balance_money = gift_card.balance | money
  assign expires_on = gift_card.expires_on | date: format: 'date'
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_money, shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
    <style>
      .gift { min-height: 100svh; display: grid; place-items: center; padding: 40px 16px; }
      .gift__card { display: grid; justify-items: center; gap: 18px; width: min(520px, 100%); padding: 36px 28px; border-radius: var(--radius); background: var(--color-surface); color: var(--color-surface-text); text-align: center; }
      .gift__logo { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 1.8rem; }
      .gift__value { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 3.4rem; line-height: 1; }
      .gift__code { padding: 12px 18px; border: 2px dashed var(--color-border); border-radius: 12px; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; }
      .gift__qr { min-width: 120px; min-height: 120px; }
      .gift__qr img, .gift__qr canvas { width: 140px; height: 140px; }
      .gift__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    </style>
  </head>
  <body class="color-{{ settings.color_schemes.first.id }}">
    <main class="gift">
      <div class="gift__card">
        <p class="gift__logo">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 400 | image_tag: width: settings.logo_width, alt: shop.name }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </p>
        <h1 class="h3">{{ 'gift_cards.issued.subtext' | t }}</h1>
        <p class="gift__value">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p>{{ 'gift_cards.issued.remaining' | t: balance: balance_money }}</p>
        {%- endif -%}
        {%- if gift_card.expired -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.enabled == false -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}

        <p class="visually-hidden">{{ 'gift_cards.issued.code' | t }}</p>
        <p class="gift__code">{{ gift_card.code | format_code }}</p>

        <div class="gift__qr" id="GiftCardQR" data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}"></div>

        <div class="gift__actions">
          <button class="button" type="button" data-copy="{{ gift_card.code }}" data-copied-text="{{ 'gift_cards.issued.copied' | t }}">{{ 'gift_cards.issued.copy' | t }}</button>
          <a class="button button--secondary" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
        </div>

        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" rel="nofollow">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        {%- endif -%}
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const box = document.getElementById('GiftCardQR');
        if (box && window.QRCode) new window.QRCode(box, { text: box.dataset.identifier, width: 140, height: 140 });
      });
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-copy]');
        if (!button) return;
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
          button.textContent = button.dataset.copiedText;
        } catch (e) {}
      });
    </script>
  </body>
</html>
