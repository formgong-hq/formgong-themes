{% doc %}
  Page links for paginated lists.

  @param {object} paginate - The paginate object
{% enddoc %}
<nav aria-label="{{ 'accessibility.page' | t: page: paginate.current_page }}">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
      <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" aria-label="{{ 'accessibility.page' | t: page: part.title }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a href="{{ paginate.next.url }}" aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'arrow-right' %}</a></li>
    {%- endif -%}
  </ul>
</nav>
