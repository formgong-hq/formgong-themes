{%- comment -%} Two (or more) full-screen slides with 01 / 02 under them. {%- endcomment -%}
<section class="hero" id="{{ section.settings.anchor | default: 'top' | handleize }}" aria-label="{{ 'lucerna.hero.label' | t }}">
  {%- for block in section.blocks -%}
    {%- capture bg -%}{%- if block.settings.image != blank -%}background-image:url({{ block.settings.image | image_url: width: 2400 }}){%- endif -%}{%- endcapture -%}
    <div class="slide{% if block.settings.image == blank %} lc-slide-empty{% endif %}" id="slide-{{ forloop.index0 }}"{% if bg != blank %} style="{{ bg }}"{% endif %} {{ block.shopify_attributes }}>
      <div class="slide-content">{% if forloop.first %}<h1>{{ block.settings.heading }}</h1>{% else %}<h2 class="h1">{{ block.settings.heading }}</h2>{% endif %}<p>{{ block.settings.text }}</p></div>
    </div>
  {%- endfor -%}
  <div class="slider-nav" role="tablist" aria-label="{{ 'lucerna.hero.slides' | t }}">
    {%- for block in section.blocks -%}
      <button class="nav-item{% if forloop.first %} is-on{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-slide="{{ forloop.index0 }}">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</button>
    {%- endfor -%}
  </div>
  <span class="nav-hl" aria-hidden="true"></span>
</section>

{% schema %}
{
  "name": "Hero slides",
  "tag": "div",
  "class": "lc-section-contents",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "top", "info": "Menu links to /#anchor scroll here." }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Light that draws the way forward." },
        { "type": "text", "id": "text", "label": "Text", "default": "A short line about what you make." }
      ]
    }
  ],
  "presets": [{ "name": "Hero slides", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
