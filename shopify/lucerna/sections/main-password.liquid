<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__inner">
    <p class="password__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: width: settings.logo_width, alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {% render 'newsletter-form', id: 'Password' %}

    <details class="password__login">
      <summary>{{ 'general.password_page.login_password_button' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field">
          <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" id="PasswordError" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>
        {%- endif -%}
        <button class="button" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
      {%- endform -%}
      <p class="password__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
    </details>
  </div>
</div>

{% stylesheet %}
  .password {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 40px 16px;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .password__inner {
    display: grid;
    justify-items: center;
    gap: 20px;
    width: min(520px, 100%);
    text-align: center;
  }

  .password__logo {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 2rem;
  }

  .password__message {
    font-size: 1.1rem;
  }

  .password__login {
    width: 100%;
  }

  .password__login summary {
    cursor: pointer;
    font-weight: var(--font-body-weight-bold);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .password__form {
    display: grid;
    gap: 12px;
    margin-top: 12px;
    text-align: left;
  }

  .password__admin {
    margin-top: 12px;
    font-size: 0.88rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
