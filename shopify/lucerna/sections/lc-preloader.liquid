{%- comment -%} The black loader: a dim light sweeps the wordmark, then it switches fully on (7 s, once per load). Skipped with reduced motion. {%- endcomment -%}
<div class="preloader" aria-hidden="true">
  <div class="pre-mark">
    <svg class="pre-dim" viewBox="0 0 236 60"><use href="#wordmark"/></svg>
    <svg class="pre-on" viewBox="0 0 236 60"><use href="#wordmark"/></svg>
  </div>
</div>
<script>document.documentElement.classList.add("no-scroll");</script>

{% schema %}
{
  "name": "Loader",
  "class": "lc-section-contents",
  "tag": "div",
  "limit": 1,
  "settings": [
    { "type": "paragraph", "content": "Shows the header wordmark on black for 7 seconds while the page loads. Remove the section to skip it." }
  ],
  "presets": [{ "name": "Loader" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
