{%- comment -%} Work stage art (angle): the case image with the plotted overlay. Param: image. {%- endcomment -%}
<div class="ct-ws__art" aria-hidden="true">
          {%- if image != blank -%}<img class="ct-ws__photo" data-b-wipe src="{{ image | image_url: width: 800 }}" srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1600 }} 1600w" sizes="(min-width: 1024px) 62vw, 100vw" width="800" height="{{ 800 | divided_by: image.aspect_ratio | round }}" alt="" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'ct-ws__photo ct-ph' }}{%- endif -%}
          <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
            <g class="plot">
              <path class="ct-wire" pathLength="1" data-p-draw d="M60 440 300 60h420"/>
              <path class="ct-guide" d="M60 440h300"/>
              <path class="ct-wire" pathLength="1" data-p-draw d="M60 440a90 90 0 0 1 84-60"/>
              <text x="160" y="420" class="ct-lbl ct-lbl--a" data-p-in>22°</text>
              <text x="310" y="48" class="ct-lbl ct-lbl--a" data-p-in>shelf angle · construction</text>
              <path d="M420 300h150v110h-150z" class="ct-wire" pathLength="1"/>
              <path d="M590 300h150v110h-150z" class="ct-wire" pathLength="1"/>
              <text x="420" y="290" class="ct-lbl" data-p-in data-b-dim>slide · w 50%</text>
              <text x="590" y="290" class="ct-lbl" data-p-in data-b-dim>next · last 1/12</text>
            </g>
            <g class="ct-live" data-live>
              <rect x="0" y="0" width="800" height="500" class="ct-veil" data-live-clip/>
              <rect x="48" y="440" width="220" height="3" class="ct-track"/>
              <rect x="48" y="440" width="73.3" height="3" class="ct-track-on" data-ws-progress/>
              <text x="290" y="447" class="ct-lbl ct-lbl--light" data-ws-counter>01 / 03</text>
            </g>
          </svg>
        </div>
