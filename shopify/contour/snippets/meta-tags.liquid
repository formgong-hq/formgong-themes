{%- comment -%}
  The document title, description, canonical link, Open Graph and X card tags, and structured data
  for products and articles. Rendered at the top of <head> by layout/theme.liquid and layout/password.liquid.
{%- endcomment -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- liquid
  assign share_title = page_title | default: shop.name
  assign share_text = page_description | default: shop.description | default: shop.name
  assign share_url = canonical_url | default: request.origin

  case request.page_type
    when 'product'
      assign share_kind = 'product'
    when 'article'
      assign share_kind = 'article'
    when 'password'
      assign share_kind = 'website'
      assign share_url = request.origin
    else
      assign share_kind = 'website'
  endcase

  capture document_title
    echo page_title
    if current_tags
      assign tag_list = current_tags | join: ', '
      echo ' – '
      echo 'general.meta.tagged' | t: tags: tag_list
    endif
    if current_page != 1
      echo ' – '
      echo 'general.meta.page' | t: page: current_page
    endif
    unless page_title contains shop.name
      if page_title != blank
        echo ' – '
      endif
      echo shop.name
    endunless
  endcapture
-%}

<title>{{ document_title | strip | escape_once }}</title>
<link rel="canonical" href="{{ canonical_url }}">
{%- if page_description != blank %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ share_kind }}">
<meta property="og:url" content="{{ share_url }}">
<meta property="og:title" content="{{ share_title | escape }}">
<meta property="og:description" content="{{ share_text | escape }}">
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width | at_most: 1200 }}">
  <meta property="og:image:height" content="{{ page_image.width | at_most: 1200 | times: page_image.height | divided_by: page_image.width }}">
  {%- if page_image.alt != blank %}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ share_title | escape }}">
<meta name="twitter:description" content="{{ share_text | escape }}">

{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <script type="application/ld+json">{{ product | structured_data }}</script>
{%- elsif request.page_type == 'article' %}
  <script type="application/ld+json">{{ article | structured_data }}</script>
{%- endif %}
