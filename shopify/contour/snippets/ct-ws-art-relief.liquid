{%- comment -%} Work stage art (relief): the case image with the plotted overlay. Param: image. {%- endcomment -%}
<div class="ct-ws__art" aria-hidden="true">
          {%- if image != blank -%}<img class="ct-ws__photo" data-b-wipe src="{{ image | image_url: width: 800 }}" srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1600 }} 1600w" sizes="(min-width: 1024px) 62vw, 100vw" width="800" height="{{ 800 | divided_by: image.aspect_ratio | round }}" alt="" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'ct-ws__photo ct-ph' }}{%- endif -%}
          <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
            <g class="plot">
              <path d="M230 130h340v200h-340z" class="ct-wire" pathLength="1"/>
              <text x="230" y="118" class="ct-lbl ct-lbl--a" data-p-in data-b-dim>route · 14.2 km · +860 m</text>
              <text x="570" y="354" text-anchor="end" class="ct-lbl ct-lbl--a" data-p-in data-b-dim>rev. 2025</text>
            </g>
            <g class="ct-live" data-live>
              <rect x="0" y="0" width="800" height="500" class="ct-veil" data-live-clip/>
              <path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill ct-hill--a" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/><path class="ct-hill" data-ws-hill/>
              <text x="40" y="470" class="ct-lbl ct-lbl--light">Lighthouse mobile · 97 · 100 · 100 · 100</text>
            </g>
          </svg>
        </div>
