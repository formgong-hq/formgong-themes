{% doc %}
  Product or variant price with compare-at price, price ranges and unit price.

  @param {product} product - The product
  @param {variant} [variant] - A specific variant; defaults to the selected or first available
  @param {boolean} [show_range] - Show "From" when variant prices differ
{% enddoc %}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if show_range and product.price_varies
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.price.sale' | t }}</span>
  {%- else -%}
    <span class="visually-hidden">{{ 'products.product.price.regular' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if show_range and product.price_varies -%}
      {%- assign price_money = price | money -%}
      {{ 'products.product.price.from_price_html' | t: price: price_money }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.price.regular' | t }}</span>
    <s class="price__compare">{{ compare | money }}</s>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ target.unit_price | money }}<span aria-hidden="true">/</span><span class="visually-hidden">&nbsp;{{ 'products.product.price.per' | t }}&nbsp;</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
