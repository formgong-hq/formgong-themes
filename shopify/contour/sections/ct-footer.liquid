{%- comment -%} Contour footer: a claim with a link, link columns, the huge mark with the privacy title block, and the bottom line. {%- endcomment -%}
<footer class="ct-site-footer ct-wrap">
  <div class="ct-grid-12 ct-footer-top">
    <p class="ct-footer-claim ct-h3">{{ section.settings.heading }}{%- if section.settings.link_label != blank -%} <a class="ct-link ct-link--inline ct-accent" href="{{ section.settings.link | default: '/#contact' }}">{{ section.settings.link_label }}</a>{%- endif -%}</p>
    {%- for block in section.blocks -%}
      <div class="ct-footer-col" {{ block.shopify_attributes }}><p class="ct-note">{{ block.settings.heading | default: block.settings.menu.title }}</p><ul>
        {%- for link in block.settings.menu.links -%}<li><a class="ct-link" href="{{ link.url }}">{{ link.title }}{% if link.type == 'http_link' %} <span class="ct-arrow" aria-hidden="true">↗</span>{% endif %}</a></li>{%- endfor -%}
      </ul></div>
    {%- endfor -%}
  </div>
  <div class="ct-footer-sign">
    <p class="ct-footer-mark" aria-hidden="true">{{ section.settings.mark | default: shop.name }}</p>
    {%- if section.settings.show_stats -%}
      <div class="ct-tb ct-note"><dl class="ct-tb__cells"><div style="--ct-i:0"><dt>{{ 'contour.footer.cookies' | t }}</dt><dd class="ct-tb__val"><span>0</span></dd></div><div style="--ct-i:1"><dt>{{ 'contour.footer.trackers' | t }}</dt><dd class="ct-tb__val"><span>0</span></dd></div><div style="--ct-i:2"><dt>{{ 'contour.footer.ads' | t }}</dt><dd class="ct-tb__val"><span>0</span></dd></div></dl><p class="ct-tb__cap"><span>{{ section.settings.stats_note }}</span>{%- if section.settings.stats_link != blank -%}<a class="ct-tb__link" href="{{ section.settings.stats_link }}">{{ 'contour.footer.read' | t }}</a>{%- endif -%}</p></div>
    {%- endif -%}
  </div>
  <div class="ct-footer-bottom ct-note">
    <p class="ct-copy"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>{%- if section.settings.credit_line != blank -%}<span>{{ section.settings.credit_line }}</span>{%- endif -%}</p>
    {%- if section.settings.show_hint -%}<span class="ct-hint">{{ 'contour.footer.grid_hint_html' | t }}</span>{%- endif -%}
    <nav class="ct-legal-links" aria-label="{{ 'contour.footer.legal' | t }}">{%- for link in section.settings.legal_menu.links -%}<a class="ct-link" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</nav>
  </div>
</footer>
{% schema %}
{
  "name": "Contour footer",
  "class": "ct-contents",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Claim", "default": "Have a project in mind?" },
    { "type": "text", "id": "link_label", "label": "Link after the claim", "default": "Let's talk." },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty: the contact section." },
    { "type": "text", "id": "mark", "label": "Huge headline", "info": "Empty: the store name." },
    { "type": "checkbox", "id": "show_stats", "label": "Show the privacy table (0 cookies, 0 trackers, 0 ads)", "default": false, "info": "Only turn it on if it is true for your store: Shopify and apps may set cookies." },
    { "type": "text", "id": "stats_note", "label": "Privacy table caption", "default": "Privacy spec" },
    { "type": "url", "id": "stats_link", "label": "Privacy table link" },
    { "type": "text", "id": "credit_line", "label": "Line after the copyright" },
    { "type": "checkbox", "id": "show_hint", "label": "Show the keyboard hint", "default": true },
    { "type": "link_list", "id": "legal_menu", "label": "Bottom links" }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "info": "Empty: the menu name." },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
