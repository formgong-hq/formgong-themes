{%- comment -%}
  Contour work: an intro, then a pinned stage (desktop) that walks through the cases with a counter, sketch / build /
  launch stages and a rail. Each case shows its image with a plotted overlay; the overlay style is picked per case.
{%- endcomment -%}
{%- assign n = section.blocks.size -%}
<section class="ct-section ct-wrap" id="work" aria-labelledby="h-{{ section.id }}">
  <header class="ct-section-head"><span class="ct-note ct-note--ink">{{ section.settings.label }}</span><span class="ct-note">{{ section.settings.note }}</span></header>
  <h2 class="ct-work__intro ct-lead" id="h-{{ section.id }}" data-reveal="up">{{ section.settings.intro }}</h2>
  <div class="ct-ws" data-work-stage>
    <div class="ct-ws__count" aria-hidden="true"><span class="ct-ws__n" data-ws-n>01</span><span class="ws__of ct-outline-text">/{{ n | prepend: '0' | slice: -2, 2 }}</span></div>
    <div class="ct-ws__stages ct-note" aria-hidden="true">
      <ol>{%- for i in (1..3) -%}{%- capture k %}step_{{ i }}{% endcapture -%}<li data-ws-stage><span>0{{ i }}</span><b>{{ section.settings[k] }}</b><i></i></li>{%- endfor -%}</ol>
      <div class="ct-ws__rail">{%- for block in section.blocks -%}<i data-ws-dot></i>{%- endfor -%}</div>
    </div>
    {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <article class="ct-ws__item" data-ws-item="{{ b.art }}" {{ block.shopify_attributes }}>
      <div class="ct-ws__text">
        <div class="ct-ws__meta"><span class="ct-note">{{ forloop.index | prepend: '0' | slice: -2, 2 }}{% if b.year != blank %} / {{ b.year }}{% endif %}</span><span class="ct-note">{{ b.stack }}</span></div>
        <h3 class="ct-h3 ct-ws__title">{{ b.title }}</h3>
        {%- if b.sub != blank -%}<p class="ct-ws__client ct-note">{{ b.sub }}</p>{%- endif -%}
        {%- if b.text != blank -%}<p class="ct-ws__summary">{{ b.text }}</p>{%- endif -%}
        <div class="ct-ws__actions">
          {%- if b.art == 'angle' -%}<button type="button" class="ct-btn ct-btn--ghost" data-ws-try hidden>{{ 'contour.work.next_slide' | t }} <span class="ct-arrow" aria-hidden="true">→</span></button>
          {%- elsif b.art == 'names' -%}<button type="button" class="ct-btn ct-btn--ghost" data-ws-try hidden>{{ 'contour.work.rename' | t }} <span class="ct-arrow" aria-hidden="true">→</span></button>{%- endif -%}
          {%- if b.button != blank -%}<a class="ct-btn ct-btn--ghost" href="{{ b.link | default: '#contact' }}">{{ b.button }}</a>{%- endif -%}
        </div>
      </div>
      {%- case b.art -%}
        {%- when 'angle' -%}{% render 'ct-ws-art-angle', image: b.image %}
        {%- when 'names' -%}{% render 'ct-ws-art-names', image: b.image %}
        {%- else -%}{% render 'ct-ws-art-relief', image: b.image %}
      {%- endcase -%}
    </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Contour work",
  "class": "ct-contents",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "[02] Selected work" },
    { "type": "text", "id": "note", "label": "Note on the right" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "A few recent builds and how they were made." },
    { "type": "text", "id": "step_1", "label": "Stage 1", "default": "Sketch" },
    { "type": "text", "id": "step_2", "label": "Stage 2", "default": "Build" },
    { "type": "text", "id": "step_3", "label": "Stage 3", "default": "Launch" }
  ],
  "blocks": [
    { "type": "case", "name": "Case", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "art", "label": "Overlay", "default": "relief", "options": [
        { "value": "angle", "label": "Angle and slider" }, { "value": "names", "label": "Labels and file names" }, { "value": "relief", "label": "Relief and route" } ] },
      { "type": "text", "id": "year", "label": "Year", "default": "2026" },
      { "type": "text", "id": "stack", "label": "Tools" },
      { "type": "text", "id": "title", "label": "Title", "default": "Project title" },
      { "type": "text", "id": "sub", "label": "Client line" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "button", "label": "Button" },
      { "type": "url", "id": "link", "label": "Button link", "info": "Empty: the contact section." }
    ] }
  ],
  "presets": [{ "name": "Contour work", "blocks": [{ "type": "case" }, { "type": "case" }, { "type": "case" }] }]
}
{% endschema %}
