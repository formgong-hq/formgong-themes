{%- comment -%}
  Marrow recipes: the dog collection and the cat collection in cards that rise in one after another; the dog/cat
  switch (here and in the hero) swaps the two grids. A card's arrow opens the quick add with its pack sizes.
{%- endcomment -%}
{%- liquid
  assign dog = section.settings.dog_collection
  assign cat = section.settings.cat_collection
  assign max_items = section.settings.limit
  assign dog_count = dog.products_count | default: 0
  assign cat_count = cat.products_count | default: 0
-%}
<section class="mw-recipes" id="{{ section.settings.anchor | default: 'recipes' | handle }}" aria-labelledby="recipes-h-{{ section.id }}">
  <div class="mw-wrap">
    <div class="mw-rhead">
      <div class="mw-ttl"><h2 class="mw-h2" id="recipes-h-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_bold != blank %}<br><b>{{ section.settings.heading_bold }}</b>{% endif %}</h2><svg class="mw-arrow-d mw-dp" viewBox="0 0 92 70" aria-hidden="true"><path pathLength="1" d="M4 10C34 2 66 14 74 50" style="--d:0s"/><path pathLength="1" d="M60 40l14 14 12-16" style="--d:.35s"/></svg></div>
      {%- if section.settings.lead != blank -%}<p class="mw-lead">{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    {%- if section.settings.show_switch -%}
      <div class="mw-seg" role="group" aria-label="{{ section.settings.switch_label | escape }}">
        <span class="mw-hl" aria-hidden="true"></span>
        <button type="button" data-pet="dog" aria-pressed="true"><svg aria-hidden="true"><use href="#mw-i-dog"/></svg>{{ section.settings.dog_label }}</button>
        <button type="button" data-pet="cat" aria-pressed="false"><svg aria-hidden="true"><use href="#mw-i-cat"/></svg>{{ section.settings.cat_label }}</button>
      </div>
    {%- endif -%}
    <ul class="mw-grid" data-grid="dog" aria-label="{{ section.settings.dog_label | escape }}">
      {%- if dog_count > 0 -%}
        {%- for product in dog.products limit: max_items -%}{% render 'mw-card', product: product, style: 'circle' %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}{% render 'mw-card', style: 'circle' %}{%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if section.settings.show_switch -%}
      <ul class="mw-grid" data-grid="cat" aria-label="{{ section.settings.cat_label | escape }}">
        {%- if cat_count > 0 -%}
          {%- for product in cat.products limit: max_items -%}{% render 'mw-card', product: product, style: 'circle' %}{%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}{% render 'mw-card', style: 'circle' %}{%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recipes grid",
  "class": "mw-sec",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our recipes" },
    { "type": "text", "id": "heading_bold", "label": "Heading, bold second line", "default": "for every bowl." },
    { "type": "textarea", "id": "lead", "label": "Text", "default": "Recipes for dogs and cats. Pick one to choose a pack size." },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "recipes" },
    { "type": "collection", "id": "dog_collection", "label": "Dog recipes collection" },
    { "type": "collection", "id": "cat_collection", "label": "Cat recipes collection" },
    { "type": "range", "id": "limit", "label": "Products per grid", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "header", "content": "Dog / cat switch" },
    { "type": "checkbox", "id": "show_switch", "label": "Show the switch and the cat grid", "default": true },
    { "type": "text", "id": "switch_label", "label": "Switch label (screen readers)", "default": "Show recipes for" },
    { "type": "text", "id": "dog_label", "label": "Dogs", "default": "Dogs" },
    { "type": "text", "id": "cat_label", "label": "Cats", "default": "Cats" }
  ],
  "presets": [{ "name": "Recipes grid" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
