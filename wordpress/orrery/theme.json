{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "color": "#040319", "name": "Background" },
				{ "slug": "surface", "color": "#0d0c26", "name": "Surface" },
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "ink", "color": "#eeeeee", "name": "Text" },
				{ "slug": "muted", "color": "#949494", "name": "Muted text" },
				{ "slug": "art", "color": "#5c5b7f", "name": "Art" },
				{ "slug": "accent", "color": "#dcfd35", "name": "Accent" },
				{ "slug": "accent-text", "color": "#040319", "name": "Text on accent" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Questrial",
					"slug": "questrial",
					"fontFamily": "\"Questrial\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--bg)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--questrial)" },
		"spacing": { "blockGap": "1.25rem" },
		"elements": { "link": { "typography": { "textDecoration": "none" } } }
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Full width, no title (Orrery pages)", "postTypes": [ "page" ] }
	]
}
