{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1280px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "color": "#0b0e1c", "name": "Background" },
				{ "slug": "surface", "color": "#121628", "name": "Surface" },
				{ "slug": "surface-2", "color": "#191e34", "name": "Surface 2" },
				{ "slug": "ink", "color": "#f2f3f7", "name": "Text" },
				{ "slug": "muted", "color": "#a5abc0", "name": "Muted text" },
				{ "slug": "line", "color": "#262b42", "name": "Line" },
				{ "slug": "accent", "color": "#ff7a29", "name": "Accent" },
				{ "slug": "accent-text", "color": "#0b0e1c", "name": "Text on accent" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Urbanist",
					"slug": "urbanist",
					"fontFamily": "\"Urbanist Variable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Urbanist Variable", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/urbanist-latin-wght-normal.D69JTELx.woff2" ] }
					]
				}
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--bg)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--urbanist)" },
		"spacing": { "blockGap": "1.25rem" },
		"elements": { "link": { "typography": { "textDecoration": "none" } } }
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Full width, no title (Craftline pages)", "postTypes": [ "page" ] }
	]
}
