{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1290px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "color": "#f7f6f3", "name": "Warm white" },
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "ink", "color": "#1d2230", "name": "Ink" },
				{ "slug": "ink-2", "color": "#3a4152", "name": "Body" },
				{ "slug": "muted", "color": "#6b7080", "name": "Muted" },
				{ "slug": "line", "color": "#e4e2dc", "name": "Line" },
				{ "slug": "sun", "color": "#ffb800", "name": "Sun" },
				{ "slug": "cobalt", "color": "#1f4fe0", "name": "Cobalt" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "name": "Poppins", "slug": "poppins", "fontFamily": "Poppins, system-ui, sans-serif" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--bg)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--poppins)", "fontSize": "14px", "lineHeight": "1.6" },
		"spacing": { "blockGap": "0" }
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	]
}
