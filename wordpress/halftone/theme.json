{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "accent", "color": "#f2621c", "name": "Orange" },
				{ "slug": "accent-2", "color": "#ffb04a", "name": "Amber" },
				{ "slug": "ink", "color": "#000000", "name": "Ink" },
				{ "slug": "paper", "color": "#ffffff", "name": "Paper" },
				{ "slug": "rule", "color": "#e5e5e5", "name": "Rule" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "name": "Figtree", "slug": "figtree", "fontFamily": "\"Figtree\", system-ui, sans-serif" },
				{ "name": "Archivo", "slug": "archivo", "fontFamily": "\"Archivo\", \"Arial Black\", Arial, sans-serif" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--figtree)" },
		"spacing": { "blockGap": "1.25rem" }
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	]
}
