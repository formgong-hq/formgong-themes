{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "680px", "wideSize": "1130px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "paper", "color": "#ffffff", "name": "Paper" },
				{ "slug": "ink", "color": "#000000", "name": "Ink" },
				{ "slug": "muted", "color": "#5e5e5e", "name": "Muted text" },
				{ "slug": "rule", "color": "#d9d9d9", "name": "Rule" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "name": "Metropolis", "slug": "metropolis", "fontFamily": "\"Metropolis\", \"Helvetica Neue\", Arial, sans-serif" },
				{ "name": "Newsreader", "slug": "newsreader", "fontFamily": "\"Newsreader Variable\", Georgia, serif" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--metropolis)" },
		"spacing": { "blockGap": "1.25rem" }
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Full width, no title (Shoal pages)", "postTypes": [ "page" ] }
	]
}
